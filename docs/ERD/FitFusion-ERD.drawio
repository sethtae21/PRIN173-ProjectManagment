<mxfile host="app.diagrams.net">
  <diagram name="Page-1" id="PP4va_N7zOQM9duGjiIa">
    <mxGraphModel dx="2138" dy="606" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    USERS ||--o{ AVATAR_PRESETS : owns\n    USERS ||--o{ SAVED_OUTFITS : creates\n    USERS ||--o| SHOPPING_CARTS : has\n    USERS ||--o{ ORDERS : places\n    USERS ||--o{ CATALOG_ITEMS : sells\n    USERS ||--o{ UPLOAD_BATCHES : submits\n\n    AVATAR_PRESETS ||--o{ SAVED_OUTFITS : used_by\n    UPLOAD_BATCHES ||--o{ CATALOG_ITEMS : produces\n\n    %% MANY-TO-MANY RESOLVED VIA MIDDLE (JUNCTION) TABLES %%\n    SAVED_OUTFITS ||--o{ OUTFIT_ITEMS : contains\n    CATALOG_ITEMS ||--o{ OUTFIT_ITEMS : included_in\n\n    SHOPPING_CARTS ||--o{ CART_ITEMS : contains\n    CATALOG_ITEMS ||--o{ CART_ITEMS : added_to\n\n    ORDERS ||--o{ ORDER_ITEMS : contains\n    CATALOG_ITEMS ||--o{ ORDER_ITEMS : purchased_in\n\n    USERS {\n        ObjectId _id PK\n        string email UK \&quot;unique required\&quot;\n        string username UK \&quot;unique required\&quot;\n        string password_hash \&quot;required\&quot;\n        string role \&quot;user or seller\&quot;\n        string store_name \&quot;nullable seller only\&quot;\n        datetime created_at\n        datetime updated_at\n    }\n\n    AVATAR_PRESETS {\n        ObjectId _id PK\n        ObjectId user_id FK \&quot;nullable for system presets\&quot;\n        boolean is_system \&quot;true = FR-2.2 pre-set avatar\&quot;\n        string name\n        string gender \&quot;male or female\&quot;\n        float height_cm \&quot;canonical unit\&quot;\n        float weight_kg \&quot;canonical unit\&quot;\n        string skin_tone\n        string undertone\n        string shoulder_width \&quot;narrow average broad\&quot;\n        string waist \&quot;slim average curvy\&quot;\n        string hip \&quot;slim average wide\&quot;\n        string cup_size \&quot;nullable female only\&quot;\n        string thigh \&quot;slim average thick\&quot;\n        datetime created_at\n        datetime updated_at\n    }\n\n    CATALOG_ITEMS {\n        ObjectId _id PK\n        ObjectId seller_id FK\n        ObjectId batch_id FK\n        string name\n        string description\n        string store_name\n        string category \&quot;tops bottoms dresses outerwear footwear\&quot;\n        string size\n        string color\n        string color_description\n        string color_family\n        array color_palette_tags\n        array style_tags\n        array occasion_tags\n        decimal price \&quot;Decimal128 exact money\&quot;\n        object images \&quot;front side rear GridFS refs\&quot;\n        string status \&quot;active or rejected\&quot;\n        array rejection_reasons\n        datetime created_at\n        datetime updated_at\n    }\n\n    UPLOAD_BATCHES {\n        ObjectId _id PK\n        ObjectId seller_id FK\n        string store_name\n        string status \&quot;processing completed failed\&quot;\n        integer total_items\n        integer accepted_count\n        integer rejected_count\n        array report \&quot;row item status reasons\&quot;\n        datetime created_at\n        datetime completed_at\n    }\n\n    SAVED_OUTFITS {\n        ObjectId _id PK\n        ObjectId user_id FK\n        ObjectId avatar_preset_id FK\n        string name\n        datetime created_at\n        datetime updated_at\n    }\n\n    OUTFIT_ITEMS {\n        ObjectId _id PK\n        ObjectId saved_outfit_id FK\n        ObjectId catalog_item_id FK\n        string size \&quot;selected size for this outfit\&quot;\n        string color \&quot;snapshot of color\&quot;\n        string category \&quot;snapshot of category\&quot;\n        string name \&quot;snapshot of item name\&quot;\n        integer sort_order \&quot;to arrange items visually\&quot;\n        datetime created_at\n    }\n\n    SHOPPING_CARTS {\n        ObjectId _id PK\n        ObjectId user_id FK \&quot;unique per user\&quot;\n        decimal total_amount \&quot;server computed Decimal128\&quot;\n        datetime created_at\n        datetime updated_at\n    }\n\n    CART_ITEMS {\n        ObjectId _id PK\n        ObjectId cart_id FK \&quot;refs SHOPPING_CARTS._id\&quot;\n        ObjectId catalog_item_id FK \&quot;refs CATALOG_ITEMS._id\&quot;\n        string name \&quot;snapshot at add-to-cart\&quot;\n        string store_name \&quot;snapshot at add-to-cart\&quot;\n        string size \&quot;selected size for this cart entry\&quot;\n        integer quantity\n        decimal price \&quot;Decimal128 snapshot at add-to-cart\&quot;\n        datetime created_at\n    }\n\n    ORDERS {\n        ObjectId _id PK\n        ObjectId user_id FK\n        string order_number UK \&quot;unique\&quot;\n        object shipping_address \&quot;street city zip\&quot;\n        string payment_method\n        string payment_status \&quot;mock approved\&quot;\n        string status\n        decimal total_amount \&quot;Decimal128\&quot;\n        datetime created_at\n        datetime updated_at\n    }\n\n    ORDER_ITEMS {\n        ObjectId _id PK\n        ObjectId order_id FK \&quot;refs ORDERS._id\&quot;\n        ObjectId catalog_item_id FK \&quot;refs CATALOG_ITEMS._id\&quot;\n        string name \&quot;snapshot at purchase\&quot;\n        string size\n        integer quantity\n        decimal unit_price \&quot;Decimal128 snapshot at purchase\&quot;\n        string store_name \&quot;snapshot of seller name\&quot;\n        string category \&quot;snapshot at time of purchase\&quot;\n        string color \&quot;snapshot at time of purchase\&quot;\n        datetime created_at\n    }&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="zAlrryPxUZpVE-VPfUKD-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
