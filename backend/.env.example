# ============================================================================
# FitFusion AI - environment TEMPLATE (committed). Copy to .env and fill the
# <angle-bracket> values. NEVER put real secrets in THIS file; real values live
# in .env, which MUST be git-ignored. Verify:  git check-ignore -v .env
# ============================================================================

# Django secret key. Placeholder here; put a real (still dev) key in .env.
# For any hosted/production deploy, generate a fresh 50-char key and set DEBUG=False.
DJANGO_SECRET_KEY=change-me-in-real-env

# Local dev keeps DEBUG=True: runserver then serves uploaded media via static()
# and opens CORS for the React dev server. Set False only for a hosted deploy.
DEBUG=True

# Live Atlas cluster (SRS 5.2). +srv IMPLIES TLS -> do NOT add tls=false.
# The query string below is the KAN-93 network hardening, NOT decoration:
#   maxIdleTimeMS=30000   proactively closes idle sockets -> kills the
#                         "first request after a few idle minutes = WinError 10054"
#                         pattern (Atlas / the LB silently drops stale TCP conns).
#   retryWrites/Reads     transparently retry ops that hit a transient reset.
#   serverSelection / connect / socket timeouts   bound the wait so a PAUSED M0
#                         free-tier cluster fails in seconds with a clear error
#                         instead of hanging ~30s mid-demo.
# Keep the path EMPTY (/) -> authSource defaults to admin, which is where Atlas
# database users live; forcing a db name here can break login. The app database
# name comes from settings.DATABASES['default']['NAME'] (fitfusion), not the URI.
# If a password contains @ : / ? # % -> percent-encode it (alphanumeric
# passwords like yours need no encoding).
MONGODB_URI=mongodb+srv://<db_user>:<DB_PASSWORD>@cluster0.zrnfpru.mongodb.net/?retryWrites=true&retryReads=true&maxIdleTimeMS=30000&serverSelectionTimeoutMS=8000&connectTimeoutMS=5000&socketTimeoutMS=10000